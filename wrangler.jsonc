{
  "name": "eko-bot",
  "main": "worker.js",
  "compatibility_date": "2025-06-01"

  // KV şimdilik KAPALI: "BURAYA_RL_ID" gibi sahte id ile `wrangler deploy` HATA verir ve Worker hiç yayına çıkmaz
  // (sitedeki "Worker'a ulaşılamadı" hatasının asıl sebebi buydu). Worker KV olmadan da çalışır (RSS çekme dahil);
  // yalnızca hız sınırı ve önbellek devre dışı kalır.
  // KV istersen: npx wrangler kv namespace create RL   ve   npx wrangler kv namespace create LOG
  // çıkan GERÇEK id'leri yazıp aşağıdaki bloğun yorumunu kaldır:
  // ,"kv_namespaces": [
  //   { "binding": "RL",  "id": "GERCEK_RL_ID" },
  //   { "binding": "LOG", "id": "GERCEK_LOG_ID" }
  // ]

  // Yapay zekâ: ANTHROPIC_API_KEY'i Cloudflare panelinde Secret olarak ekle, worker.js'de YAPAY_ZEKA=true yap.
}
